<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="QA Automation Suite">

    <listeners>
        <listener class-name="com.example.reports.ExtentTestListener"/>
    </listeners>

    <test name="Sanity Tests">

        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>

        <classes>
            <class name="com.example.tests.SanityTest"/>
            <class name="com.example.tests.LoginPageTest"/>
            <class name="com.example.tests.DashboardPageTest"/>
            <class name="com.example.tests.FavoriteSectionsTest"/>
            <class name="com.example.tests.InstrumentHealthTest"/>
            <class name="com.example.tests.ChangePasswordTest"/>
        </classes>

    </test>

    <!-- Framework unit tests: no backend or account, so no group filter. -->
    <test name="Framework Unit Tests">
        <classes>
            <class name="com.example.unit.ConfigReaderTest"/>
            <class name="com.example.unit.DriverFactoryTest"/>
            <class name="com.example.unit.BrowserUtilsTest"/>
        </classes>
    </test>

</suite>