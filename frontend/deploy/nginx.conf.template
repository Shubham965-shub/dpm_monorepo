# Envsubst template: the nginx image replaces ${BACKEND_ORIGIN} at container start (only vars present
# in the container env are replaced, so nginx's own $vars survive). BACKEND_ORIGIN is a mandatory app
# setting - scheme://host, no trailing slash, e.g. https://helios-backend-lhprd.azurewebsites.net
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Timeouts match argus-frontend's tested values; App Service itself caps a request at 230s.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_send_timeout 60s;
    }

    # Hashed build assets are immutable.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback; index.html is never cached so a new deploy is picked up on the next load.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
