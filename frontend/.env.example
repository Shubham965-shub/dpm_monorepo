# Copy to .env and adjust if the backend runs somewhere other than localhost:8080.
VITE_API_URL=http://localhost:8080

# --- Analytics (optional) ---------------------------------------------------
#
# PostHog (self-hosted). Leave both unset to keep analytics fully disabled - see lib/analytics.ts.
#VITE_POSTHOG_KEY=
#VITE_POSTHOG_HOST=
#VITE_POSTHOG_APP=helios

# --- Feedback widget (optional) ---------------------------------------------
#
# Leave both unset to hide the header's Feedback button entirely - see FeedbackLauncher.tsx.
#VITE_FEEDBACK_APP_KEY=
#VITE_FEEDBACK_API_BASE_URL=
