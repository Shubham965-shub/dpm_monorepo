# Copy to .env and adjust if the backend runs somewhere other than localhost:8080.
VITE_API_URL=http://localhost:8080

# --- Analytics (optional) ---------------------------------------------------
#
# PostHog (self-hosted) - a single project shared across Strides apps (same project
# InvestigationAI/CPV_Platform report into; not secret, project tokens are meant to ship
# client-side - see deploy-frontend-qa.yml for the real values). Left unset HERE on purpose, even
# though the values aren't secret: local dev should stay analytics-free by default (see
# lib/analytics.ts's own doc comment) - uncomment only if you deliberately want your own local
# testing to show up in the shared project.
#VITE_POSTHOG_KEY=phc_nSFXA6dYnM6N2sRHTJxqPHuhf8yzwa7bkQsBvfAiYuMV
#VITE_POSTHOG_HOST=https://posthog.strideslighthouse.com
#VITE_POSTHOG_APP=helios

# --- Feedback widget (optional) ---------------------------------------------
#
# Leave unset to hide the header's Feedback button entirely - see FeedbackLauncher.tsx. This URL is
# shared across Strides apps and isn't secret (same value InvestigationAI's own
# deploy-qa-frontend.yml bakes in directly). The app key ("helios") is fixed in FeedbackLauncher.tsx
# itself, not env-driven - it doesn't vary by environment the way this URL does.
VITE_FEEDBACK_API_BASE_URL=https://feedback-service.graysand-fe5571c1.centralindia.azurecontainerapps.io/api/v1
