# lighthouse-kit-template: platform.env v0.1.0
# Use-case manifest - the single source of app parameters for the deploy/prd01 scripts and the
# lighthouse platform-kit skills. Shell-sourceable; no secrets. Platform-wide constants
# (SUB/RG/VNET/KV/ACR/PG/plan) live in lib-deploy.sh.

USE_CASE=helios
DB_NAME=helios

BACKEND_APP=helios-backend-lhprd
FRONTEND_APP=helios-frontend-lhprd
BACKEND_IMAGE=helios-backend
FRONTEND_IMAGE=helios-frontend
BACKEND_PORT=8080
FRONTEND_PORT=80
BACKEND_HEALTH_PATH=/q/health/ready

# Pinned private-endpoint IPs (snet-privatelink 10.23.199.64/27), claimed in the kit registry
# (lighthouse-platform-kit PR #9). Corp DNS and the network allow-list hard-code these - never change.
BACK_PE_IP=10.23.199.82
FRONT_PE_IP=10.23.199.83

# Per-use-case Key Vault secret names (acr-*, pg-admin-password, node-auth-token are platform-level).
KV_JWT_SECRET=helios-jwt-secret
# The shared feedback service verifies tokens with argus's JWT secret, so reference that secret
# directly rather than keeping a copy that would drift when it is rotated.
KV_JWT_FEEDBACK_SECRET=prod-jwt-secret

PUBLIC_URL=https://helios.strides.com

# QA registry the backend image is promoted from (built there by deploy-backend-qa.yml on every push
# to `qa`, tagged with the 12-char git SHA). Public, admin disabled - imports use your az login.
QA_SUBSCRIPTION=STRIDES-RISE-LH-01
QA_RG=QA-Lighthouse
QA_ACR=dpmqaacr
QA_BACKEND_IMAGE=dpm-backend
TAG_SHA_LENGTH=12

# Frontend build args (baked at build time). Not secrets - same values deploy-frontend-qa.yml uses.
# FEEDBACK_API_BASE_URL is empty for v1, which hides the Feedback button.
POSTHOG_KEY=phc_nSFXA6dYnM6N2sRHTJxqPHuhf8yzwa7bkQsBvfAiYuMV
POSTHOG_HOST=https://posthog.strideslighthouse.com
FEEDBACK_API_BASE_URL=
